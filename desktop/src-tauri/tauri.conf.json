{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Check Bench",
  "version": "../../package.json",
  "identifier": "io.andradev.voicecb",
  "build": {
    "beforeDevCommand": { "script": "npx vite --port 1420 --strictPort", "cwd": "../.." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../.." },
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Check Bench",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RkM5NDREMTZBNTlDMDgKUldRSW5LVVdUWlQ4Rm4wTFJtVVIyVFFka21nSEQwYkhOY3cxUEZHa0xNQ1k1TjVFSWZnWUZ2TU8K",
      "endpoints": ["https://github.com/dev-vinicius-andrade/voice-check-bench/releases/download/updater/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
